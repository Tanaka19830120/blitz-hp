generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  PLAYER
}

enum AttendanceStatus {
  ATTENDING
  ABSENT
  PENDING
  MAYBE
}

enum GameResult {
  WIN
  LOSE
  DRAW
}

enum GameType {
  REGULAR
  PRACTICE
  TOURNAMENT
  EVENT
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(PLAYER)
  number    Int?
  position  String?
  photoUrl  String?
  isGuest   Boolean  @default(false)   // 助っ人（メンバー一覧・個人成績ランキングから除外）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendances   Attendance[]
  gameStats     GameStat[]
  pitchingStats PitchingStat[]
  lineups       Lineup[]
  photos        Photo[]
}

model Schedule {
  id         String   @id @default(cuid())
  date       DateTime
  opponent   String
  location   String
  type       GameType @default(REGULAR)
  meetTime   String?
  startTime  String?
  note       String?
  dayGroupId String?  // 同日複数試合グループ識別子（同値のScheduleを1枚のカードで表示）
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  attendances Attendance[]
  game        Game?
  lineups     Lineup[]
}

model Attendance {
  id         String           @id @default(cuid())
  status     AttendanceStatus @default(PENDING)
  note       String?
  createdAt  DateTime         @default(now())
  userId     String
  scheduleId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([userId, scheduleId])
}

model Game {
  id            String     @id @default(cuid())
  ourScore      Int
  opponentScore Int
  result        GameResult
  note          String?
  inningScores  String?    // JSON: {"blitz":[0,1,2],"opponent":[1,0,0]}
  scorebook     String?    // JSON: ScoreBookData (per-inning per-batter results)
  scorePhoto    String?    // URL: スコア表写真（Vercel Blob）
  teamsOneId    String?    @unique
  createdAt     DateTime   @default(now())
  scheduleId    String     @unique

  schedule      Schedule       @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  stats         GameStat[]
  pitchingStats PitchingStat[]
}

model PitchingStat {
  id          String  @id @default(cuid())
  decision    String? // 勝・負・S・H・null
  innings     String  @default("0")  // 例: "5回0/3"
  pitches     Int     @default(0)
  runsAllowed Int     @default(0)
  earnedRuns  Int     @default(0)
  hitsAllowed Int     @default(0)
  strikeouts  Int     @default(0)
  walks       Int     @default(0)
  userId      String
  gameId      String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

model GameStat {
  id               String  @id @default(cuid())
  atBats           Int     @default(0)
  hits             Int     @default(0)
  doubles          Int     @default(0)
  triples          Int     @default(0)
  homeRuns         Int     @default(0)
  rbi              Int     @default(0)
  runs             Int     @default(0)
  stolenBases      Int     @default(0)
  strikeouts       Int     @default(0)
  walks            Int     @default(0)
  hitByPitch       Int     @default(0)
  sacrificeBunts   Int     @default(0)
  sacrificeFlies   Int     @default(0)
  plateAppearances Int     @default(0)
  position         String?
  battingOrder     Int?
  userId           String
  gameId           String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

model Setting {
  key   String @id
  value String
}

model Lineup {
  id           String   @id @default(cuid())
  battingOrder Int?
  position     String?
  isDH         Boolean  @default(false)
  createdAt    DateTime @default(now())
  userId       String
  scheduleId   String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([userId, scheduleId])
}

// ── 写真アルバム（イベント・試合の写真） ──
model PhotoAlbum {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  createdAt DateTime @default(now())

  photos    Photo[]

  @@index([date])
}

model Photo {
  id           String     @id @default(cuid())
  albumId      String
  url          String
  uploadedById String?
  createdAt    DateTime   @default(now())

  album        PhotoAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  uploadedBy   User?      @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([albumId])
}
